---
import { links } from "../lib/offers";

interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
const prefix = home ? "" : "/";
const items = [
  { href: "#probleme", label: "Le problème" },
  { href: "#calculateur", label: "Calculateur" },
  { href: "#kit", label: "Le kit" },
  { href: "#offres", label: "Prix" },
  { href: "#faq", label: "FAQ" },
];
---

<header class="site-header">
  <div class="container bar">
    <a href={home ? "#top" : "/"} class="brand">
      <span class="monogram" aria-hidden="true">CR</span>
      <span class="brand-name">Coût Réel</span>
    </a>
    <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="nav-principale">
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      Menu
    </button>
    <nav id="nav-principale" aria-label="Navigation principale" class="nav">
      {items.map((item) => <a href={`${prefix}${item.href}`}>{item.label}</a>)}
      <a href={links.kit()} class="btn btn-primary nav-cta">Obtenir le kit</a>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.querySelector(".menu-toggle");
    var nav = document.getElementById("nav-principale");
    if (!btn || !nav) return;
    function set(open) { btn.setAttribute("aria-expanded", String(open)); nav.classList.toggle("is-open", open); }
    btn.addEventListener("click", function () { set(btn.getAttribute("aria-expanded") !== "true"); });
    nav.addEventListener("click", function (e) { if (e.target.closest("a")) set(false); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape" && nav.classList.contains("is-open")) { set(false); btn.focus(); } });
  })();
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }
  .bar {
    padding-top: 16px;
    padding-bottom: 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    text-decoration: none;
    color: var(--ink);
  }
  .brand:hover {
    color: var(--ink);
  }
  .monogram {
    display: inline-flex;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--ink);
    color: var(--bg);
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    font-size: 15px;
  }
  .nav a:not(.btn) {
    color: var(--ink);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .nav a:not(.btn):hover {
    color: var(--accent);
  }
  .nav-cta {
    padding: 10px 18px;
    border-radius: 8px;
    font-size: 15px;
  }
  .menu-toggle {
    display: none;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 14px;
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    background: transparent;
    border: 1.5px solid var(--ink);
    border-radius: 8px;
    cursor: pointer;
  }

  @media (max-width: 759.98px) {
    :global(html.js) .menu-toggle {
      display: inline-flex;
    }
    .nav {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
      font-size: 17px;
    }
    .nav-cta {
      margin-top: 8px;
      font-size: 17px;
    }
    :global(html.js) .nav {
      display: none;
    }
    :global(html.js) .nav.is-open {
      display: flex;
    }
  }
</style>
